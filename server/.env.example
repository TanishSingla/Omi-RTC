# Copy to .env (local) or set in your host's dashboard (production).
PORT=3001

# Where the frontend is served from. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when behind a proxy (Render/Railway/Fly) so rate limits use the real client IP.
TRUST_PROXY=0

# Optional TURN relay (see README "TURN"). Leave empty for STUN only.
# Example (Metered Open Relay, values from your free dashboard):
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Report log file (JSON lines).
REPORT_LOG=reports.log
